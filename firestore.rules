rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile data — only the owner can read/write
    match /priceOracleUsers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // User lists and cards — only the owner can read/write
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Price history, keyed by oracle_id. Public read so unauthenticated
    // mobile users see charts; writes still require auth.
    //
    // This block is why the collection rename needed a rules change at
    // all: rules match collection names literally, so cardHistory was
    // invisible to the site — every chart got PERMISSION_DENIED — until
    // it was named here.
    match /cardHistory/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /snapshots/{snapshotId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    // Legacy, keyed by printing id. No longer written, but the frontend
    // still reads it and merges it with the above, so it stays readable
    // until its days age out of the charting window.
    match /priceHistory/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /snapshots/{snapshotId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
